/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-V2f6i3RuelvpYlifqjIaYWAeH75Cs4A1BaX7Qrlv0sw='; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; form-action 'none'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; upgrade-insecure-requests

# ------------------------------------------------------------------
# 애드센스 도입 시 위 Content-Security-Policy 한 줄을 아래로 교체하세요.
# (한 줄로 붙여야 하며, 줄바꿈하면 적용되지 않습니다)
#
# Content-Security-Policy: default-src 'self'; script-src 'self' 'sha256-V2f6i3RuelvpYlifqjIaYWAeH75Cs4A1BaX7Qrlv0sw=' https://pagead2.googlesyndication.com https://googleads.g.doubleclick.net https://tpc.googlesyndication.com https://adservice.google.com https://www.googletagservices.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://pagead2.googlesyndication.com https://googleads.g.doubleclick.net; frame-src https://googleads.g.doubleclick.net https://tpc.googlesyndication.com; form-action 'none'; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; upgrade-insecure-requests
#
# 주의 1: 애드센스는 인라인 <style> 을 주입하므로 style-src 에 'unsafe-inline' 이 필요합니다.
# 주의 2: index.html 의 JSON-LD 블록을 수정하면 위 sha256 해시가 달라집니다.
#         아래 명령으로 새 해시를 뽑아 두 곳 모두 교체하세요.
#         node -e "const f=require('fs'),c=require('crypto');const m=f.readFileSync('index.html','utf8').match(/<script type=\"application\/ld\+json\">([\s\S]*?)<\/script>/);console.log('sha256-'+c.createHash('sha256').update(m[1],'utf8').digest('base64'))"
# ------------------------------------------------------------------

/assets/*
  Cache-Control: public, max-age=3600, must-revalidate
