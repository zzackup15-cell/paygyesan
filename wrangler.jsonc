{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paygyesan",
  "compatibility_date": "2026-08-03",

  // 정적 자산만 배포한다. 워커 스크립트가 없으므로 main / binding 은 두지 않는다.
  //
  // directory 를 "." 로 두면 .git 디렉터리와 README, tools/ 까지 전부
  // 공개 웹에 올라간다. 실제로 그렇게 배포된 적이 있어 public/ 로 분리했다.
  // 사이트에 나가야 할 파일만 public/ 안에 둘 것.
  "assets": {
    "directory": "./public",
    "not_found_handling": "404-page"
  },

  // 커스텀 도메인. zone 이 이 계정에 Active 여야 하며, 배포 시 DNS 레코드가
  // 자동 생성된다. www 도 붙여야 www 로 접속하는 사용자가 실패하지 않는다.
  // 두 주소가 같은 내용을 서빙하지만 canonical 이 apex 를 가리키므로
  // 검색엔진은 paygyesan.com 으로 통합한다.
  "routes": [
    { "pattern": "paygyesan.com", "custom_domain": true },
    { "pattern": "www.paygyesan.com", "custom_domain": true }
  ],

  // 도메인 연결을 확인한 뒤 false 로 바꿔 *.workers.dev 주소를 끈다.
  "workers_dev": true,
  "preview_urls": false,

  "observability": {
    "enabled": true
  }
}
